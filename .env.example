# Evenly: every setting, for the website and the database scripts. Copy to .env and fill in.
# Never commit .env.

# ---------- Supabase (what the website talks to)
# Local: `npm run db:start` prints both (API URL, Publishable key).
# Hosted: Dashboard > Project Settings > API (URL and the sb_publishable_ key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------- AI (bill reading and "who had what"), used only on the server
# Gemini: https://aistudio.google.com/apikey (the free tier may use requests to improve Google's products)
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys (needed for voice and typed splits)
GROQ_API_KEY=
# RECEIPT_MODELS=gemini:gemini-3.5-flash-lite,groq:qwen/qwen3.8-27b,gemini:gemini-3.8-flash
# RECEIPT_TIMEOUT_SECONDS=20
# Per account per day; protects your free AI quotas.
# AI_SCANS_PER_DAY=40
# AI_ASSIGNS_PER_DAY=100

# ---------- Email (Gmail with an app password: https://myaccount.google.com/apppasswords)
# For the hosted project these go in Dashboard > Authentication > SMTP (see README); these two
# are only read locally, when the Gmail block in supabase/config.toml is uncommented.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ---------- Database connection for `npm run db:push` (applies supabase/migrations)
# Hosted: Dashboard > Connect > Session pooler.
POSTGRES_HOST=aws-0-<region>.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.<project-ref>
POSTGRES_PASSWORD=

# ---------- Supabase Management API (optional: scripts that read or change the hosted project's
# auth settings). https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
